# ── 필수 ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=
CLIENT_ID=
# 특정 서버에만 슬래시 명령어를 즉시 등록하려면 입력. 비우면 전역 등록(최대 1시간)
GUILD_ID=

# ── 무료 호스팅 (Render / Replit + UptimeRobot) ────────────────────────────
# keep-alive 웹 서버가 바인딩할 포트. Render는 이 값을 자동으로 주입한다.
# 로컬이나 pm2로 돌릴 때는 웹 서버가 필요 없으므로 DISABLE_KEEPALIVE=1로 끈다.
PORT=3000
# DISABLE_KEEPALIVE=1

# ── 오디오 엔진 ────────────────────────────────────────────────────────────
# auto(기본)  : play-dl로 조회하고, 스트림이 막히면 yt-dlp로 자동 전환 (권장)
# playdl      : play-dl만. ⚠️ 2026년 8월 현재 play-dl은 재생 URL을 풀지 못한다.
#               정보 조회만 되고 소리는 안 나므로 고정하지 말 것 (README 참고)
# ytdlp       : yt-dlp만
AUDIO_ENGINE=auto
# play-dl 소스 품질. 0=낮음 1=중간 2=높음(기본). 메모리가 빠듯하면 1로 낮춘다.
# PLAYDL_QUALITY=2
# postinstall의 yt-dlp 다운로드(약 40MB)를 건너뛴다.
# ⚠️ 지금은 yt-dlp가 실제 재생을 담당하므로 켜면 소리가 나지 않는다.
# SKIP_YTDLP_DOWNLOAD=1

# ── 유튜브 IP 차단 회피 (쿠키) ─────────────────────────────────────────────
# 무료 호스팅의 공용 IP는 "Sign in to confirm you're not a bot"으로 막히는 일이 잦다.
# 아래 중 하나만 채우면 된다. 자세한 발급 방법은 README의 "유튜브 쿠키 설정" 참고.
#
# 1) 브라우저 Cookie 헤더를 그대로 붙여넣기 (Render처럼 파일을 올릴 수 없는 환경에 적합)
# YOUTUBE_COOKIE=SID=...; HSID=...; SSID=...; APISID=...; SAPISID=...
#
# 2) 쿠키 파일 경로 (헤더 형식 / Netscape cookies.txt 둘 다 인식)
# YOUTUBE_COOKIE_FILE=./data/youtube-cookies.txt
#
# 3) yt-dlp용 쿠키 파일. 지정하면 play-dl과 yt-dlp가 이 파일 하나를 같이 쓴다.
# YTDLP_COOKIES=./data/cookies.txt

# 유튜브 봇 판정을 쿠키 없이 비껴가려는 시도. 계정을 걸지 않아도 되므로 쿠키보다 먼저
# 시도해볼 값이다. 막히면 다른 조합으로 바꿔가며 시도한다.
# (android_vr / tv_embedded / tv / web_safari / ios / mweb ...)
# YTDLP_PLAYER_CLIENT=android_vr,tv_embedded

# 그 밖의 yt-dlp 인자. 따옴표로 묶인 값도 인식한다.
# YTDLP_EXTRA_ARGS=--extractor-args "youtube:player_client=tv" --sleep-requests 1

# 유튜브에 보낼 User-Agent. 비우면 최신 크롬 UA를 쓴다.
# YOUTUBE_USER_AGENT=

# ── 기타 ───────────────────────────────────────────────────────────────────
# Opus 인코딩 비트레이트 상한(kbps). CPU가 빠듯한 호스팅에서 낮춰 쓴다. (실효 상한 128)
# MAX_OPUS_BITRATE=96
# SQLite 파일 경로. 기본값은 data/bot.sqlite
# BOT_DB_PATH=
# yt-dlp 바이너리를 직접 지정할 때
# YTDLP_PATH=
